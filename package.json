{
  "name": "@wms/repo",
  "private": true,
  "scripts": {
    "peers:install": "yarn workspaces foreach -A -v run peers:install",
    "postinstall": "yarn peers:install",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "create:uim": "node scripts/create-ui-module.mjs",
    "generate:component": "turbo gen react-component",
    "build:uip": "turbo run build --filter=\"./packages/ui/*\"",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "publish": "yarn build:uip && yarn workspace @wms/ui build",
    "dev:board": "turbo run dev  --filter=\"./packages/ui/board\" --filter=\"./packages/ui/core\" --filter=\"./packages/styles\"",
    "dev:gantt": "turbo run dev  --filter=\"./packages/ui/gantt\" --filter=\"./packages/ui/core\" --filter=\"./packages/styles\"",
    "dev:list": "turbo run dev --filter=\"./packages/ui/list\" --filter=\"./packages/ui/table\" --filter=\"./packages/ui/core\" --filter=\"./packages/styles\"",
    "dev:projects": "turbo run dev  --filter=\"./packages/ui/projects\" --filter=\"./packages/ui/core\" --filter=\"./packages/styles\"",
    "dev:table": "turbo run dev  --filter=\"./packages/ui/table\" --filter=\"./packages/ui/core\" --filter=\"./packages/styles\""
  },
  "hooks": {
    "pre-commit": "yarn lint && yarn format",
    "pre-push": "yarn build"
  },
  "devDependencies": {
    "install-peers-cli": "^2.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=20"
  },
  "resolutions": {
    "axios": "^1.12.2",
    "yup": "^1.7.1",
    "dayjs": "^1.11.18",
    "@mantine/core": "8.1.3",
    "@mantine/hooks": "8.1.3",
    "@mantine/dates": "8.1.3",
    "@mantine/modals": "8.1.3",
    "@mantine/notifications": "8.1.3",
    "@tanstack/react-query": "5.81.5",
    "i18next": "25.5.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "16.0.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0"
  },
  "workspaces": [
    "packages/*",
    "packages/ui/*"
  ]
}
