{
  "name": "@wms/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/wms-ui.cjs",
  "module": "./dist/wms-ui.es.js",
  "unpkg": "./dist/wms-ui.iife.js",
  "jsdelivr": "./dist/wms-ui.iife.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/wms-ui.es.js",
      "require": "./dist/wms-ui.cjs",
      "default": "./dist/wms-ui.es.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prebuild": "[ -d node_modules ] || yarn install",
    "build": "yarn prebuild && vite build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@mantine/core": "8.1.3",
    "@mantine/dates": "8.1.3",
    "@mantine/hooks": "8.1.3",
    "@mantine/modals": "8.1.3",
    "@mantine/notifications": "8.1.3",
    "@tanstack/react-query": "5.81.5",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "i18next": "25.5.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "16.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@wms/eslint-config": "workspace:*",
    "@wms/typescript-config": "workspace:*",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4"
  }
}
